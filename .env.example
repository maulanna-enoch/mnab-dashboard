GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
SHEET_ID=114Ly5pJgF0hOYLb8oCazEiuuB9ndbY6Z61PagSAicas

# Write-capable service account (Editor access) -- see README section 5.
# Used only by the Transactions write endpoint(s), never by read-only pages.
GOOGLE_WRITE_SERVICE_ACCOUNT_EMAIL=your-writer-service-account@your-project.iam.gserviceaccount.com
GOOGLE_WRITE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_WRITE_KEY_HERE\n-----END PRIVATE KEY-----\n

# NOTE: in Vercel's Environment Variables UI, paste GOOGLE_PRIVATE_KEY's value
# WITHOUT surrounding quotes. Keep the \n as literal backslash-n text (not
# real line breaks) -- the app code converts them to real newlines at runtime.
